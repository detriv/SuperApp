             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             x:Class="SuperApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <buttons:SfButton x:Name="btnLogin"
                  Text="Button"
                  Clicked="btnLogin_Clicked"
                  TextColor="White">
            </buttons:SfButton>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
