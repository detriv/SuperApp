<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:carousel="clr-namespace:Syncfusion.Maui.Carousel;assembly=Syncfusion.Maui.Carousel"
             xmlns:models="clr-namespace:SuperApp.Models"
             x:Class="SuperApp.Views.HomePage"
             BackgroundColor="#F4F6FB"
             Title="HomePage">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="20,16,20,24">

            <!-- ===================== PROFILE SECTION ===================== -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">

                <!-- Avatar (inisial nama, tanpa dependensi gambar/font icon) -->
                <Border Grid.Column="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeShape="RoundRectangle 23"
                        Stroke="Transparent"
                        Padding="0"
                        BackgroundColor="#5B67F1">
                    <Label Text="BS"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Sapaan + nama -->
                <VerticalStackLayout Grid.Column="1"
                                      VerticalOptions="Center"
                                      Margin="12,0,0,0"
                                      Spacing="0">
                    <Label Text="Halo,"
                           FontSize="12"
                           TextColor="#8A8FA3" />
                    <Label Text="Budi Santoso"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#1E1E2D" />
                </VerticalStackLayout>

                <!-- Icon notifikasi -->
                <Border Grid.Column="2"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        Padding="0"
                        BackgroundColor="White"
                        VerticalOptions="Center">
                    <Grid>
                        <Label Text="&#xe7f4;"
                               FontFamily="MaterialIcons"
                               FontSize="20"
                               TextColor="#4B4F5E"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <!-- Badge notifikasi -->
                        <Border WidthRequest="8"
                                HeightRequest="8"
                                StrokeShape="RoundRectangle 4"
                                Stroke="Transparent"
                                Padding="0"
                                BackgroundColor="#E24B4A"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,6,6,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== CAROUSEL BANNER ===================== -->
            <carousel:SfCarousel x:Name="BannerCarousel"
                                  HeightRequest="130"
                                  ItemsSource="{Binding Banners}"
                                  ViewMode="Linear"
                                  ItemSpacing="10"
                                  LoadMoreItemsCount="0">
                <carousel:SfCarousel.ItemTemplate>
                    <DataTemplate x:DataType="models:BannerItem">
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="Transparent"
                                Padding="18,0"
                                BackgroundColor="{Binding BackgroundColor}">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Subtitle}"
                                       FontSize="12"
                                       TextColor="White"
                                       Opacity="0.85" />
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </carousel:SfCarousel.ItemTemplate>
            </carousel:SfCarousel>

            <!-- Indikator dot (statis, mengikuti jumlah banner) -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                    Spacing="6"
                                    Margin="0,10,0,24"
                                    BindableLayout.ItemsSource="{Binding Banners}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <BoxView WidthRequest="6"
                                 HeightRequest="6"
                                 CornerRadius="3"
                                 Color="#D3D1C7" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <!-- ===================== MENU 4x4 ===================== -->
            <Label Text="Menu"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1E1E2D"
                   Margin="2,0,0,12" />

            <CollectionView ItemsSource="{Binding Menus}"
                             SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="3"
                                      VerticalItemSpacing="9"
                                      HorizontalItemSpacing="3" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MenuItem">
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="MenuItem_Tapped" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Border WidthRequest="86"
                                        HeightRequest="86"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="Transparent"
                                        Padding="0"
                                        BackgroundColor="{Binding BackgroundColor}">
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="MaterialIcons"
                                           FontSize="50"
                                           TextColor="{Binding IconColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       TextColor="#5F5E5A"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>